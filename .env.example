# Host app → Docker Postgres on localhost (published port 5432 matches docker-compose.yml).
# Next.js inside Compose would use host `postgres` instead of `localhost`.
DATABASE_URL=postgresql://climate:climate_dev_password@localhost:5432/climate_action_tracker

# --- LLM import (server-only; never expose keys to the client) ---
LLM_INFERENCE_MODE=local_first
LLM_LOCAL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest
# Ollama "thinking" models default to emitting reasoning before `content`; `/api/import-action` disables that (`think:false`) so JSON lands in `message.content`.
LLM_REQUEST_TIMEOUT_MS=120000
ENABLE_CLOUD_FALLBACK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: when set, `/admin` requires sign-in at `/admin/login` (sets HTTP-only `admin_demo`) OR `Authorization: Bearer <secret>` for mutations. See `src/server/admin-auth.ts`; JWT peek helper (`peekUnverifiedJwtClaims`) does not verify signatures.
ADMIN_DEMO_SECRET=
